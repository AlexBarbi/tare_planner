<launch>
  <!-- Terrain analysis + TARE exploration on top of fast_lio_slam_launch.xml, driving OptiPessiController, with one rviz
       showing robot, LIO, terrain, exploration and OptiPessi plans. Start it after fast_lio_slam_launch.xml, once the
       robot stands (OptiPessi stands until the first goal).
       Topics: TARE reads /Odometry (FAST-LIO), /registered_scan_static (FAST-LIO /cloud_registered through people_perception
               dynamic_points_filter, which fast_lio_slam_launch.xml starts), /terrain_map, /terrain_map_ext
               (tare_planner/config/aliengo.yaml) and publishes /way_point, /exploration_path, /global_path_full
               (frame map). tare_path_to_opti_pessi_goal.py does not relay /way_point: it sends /opti_pessi/goal (odom)
               at the middle point between the robot and /way_point (the TARE paths are not used).
       TF:  odom -> lio_map -> camera_init -> map, as in far_planner_nav_launch.xml (odom -> lio_map from lio_odom_alignment.py).
       auto_start:=false waits for  ros2 topic pub -1 /start_exploration std_msgs/msg/Bool "{data: true}".
       ros2 topic pub -1 /reset_waypoint std_msgs/msg/Empty "{}" stops the robot where it is (TARE waypoint = robot position).
       save_graph: far_planner runs along only to build its visibility graph, saved as graph_name next to map_name when
       the exploration ends, then stopped; far_planner_launch.xml loads it in the next missions. It reads its own
       terrain maps (/terrain_map_static, /terrain_map_ext_static), made from /registered_scan_static: the graph is
       for later, the people walking by now must not be in it. -->
  <arg name="use_sim_time" default="true"/>
  <arg name="terrain" default="true" description="Run terrainAnalysis and terrainAnalysisExt (false if already running)"/>
  <arg name="rviz" default="true"/>
  <arg name="tare_config" default="aliengo" description="Config file stem in tare_planner/config"/>
  <arg name="auto_start" default="false" description="Explore at once; false waits for /start_exploration"/>
  <arg name="waypoint" default="false" description="The robot follows a waypoint instead a middle point between the robot and the TARE waypoint (false: middle point)"/>
  <arg name="merge_map" default="true" description="When TARE finishes exploring: the robot returns home (return_home), then stop TARE and the robot, merge the SC-PGO keyframes into map_name"/>
  <arg name="return_home" default="true" description="With merge_map: when TARE finishes exploring it walks the robot back to where it started, and only then is it stopped and the map merged; false stops the robot where the exploration ends"/>
  <arg name="return_home_timeout" default="600.0" description="Seconds given to the return home; after that the robot is stopped where it is and the map merged"/>
  <arg name="map_name" default="optimized_map.pcd" description="Merged map file, in the SC-PGO save_directory"/>
  <arg name="save_graph" default="true" description="Run far_planner during the exploration and save its graph as graph_name at the end (needs merge_map)"/>
  <arg name="graph_name" default="warehouse.vgh" description="FAR visibility graph file, in the SC-PGO save_directory"/>
  <arg name="far_config" default="default" description="Config file stem in far_planner/config"/>

  <node pkg="fast_lio" exec="lio_odom_alignment.py" name="lio_odom_alignment" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
  <node pkg="tf2_ros" exec="static_transform_publisher" name="camera_init_to_map"
    args="--frame-id camera_init --child-frame-id map"/>

  <!-- carveDyObs (local patch): stored obstacle points that rays of the current scan now pass through are deleted, so
       people and other things that moved away leave no ghosts in /terrain_map (and in /terrain_map_ext, which takes
       /terrain_map within 4 m). clearDyObs stays off: its vertical FOV params are not tuned for the pitched Airy dome.
       legged_gazebo/config/terrain_airy.yaml: floor prior and obstacle band for a lidar that does not see the floor
       around the robot. -->
  <node if="$(var terrain)" pkg="terrain_analysis" exec="terrainAnalysis" name="terrainAnalysis" output="screen">
    <param from="$(find-pkg-share legged_gazebo)/config/terrain_airy.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="carveDyObs" value="true"/>
    <remap from="/state_estimation" to="/Odometry"/>
    <remap from="/registered_scan" to="/cloud_registered"/>
  </node>
  <node if="$(var terrain)" pkg="terrain_analysis_ext" exec="terrainAnalysisExt" name="terrainAnalysisExt" output="screen">
    <param from="$(find-pkg-share legged_gazebo)/config/terrain_airy.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="/state_estimation" to="/Odometry"/>
    <remap from="/registered_scan" to="/cloud_registered"/>
  </node>

  <!-- name must stay tare_planner_node: the yaml is keyed by node name -->
  <node pkg="tare_planner" exec="tare_planner_node" name="tare_planner_node" output="screen">
    <param from="$(find-pkg-share tare_planner)/$(var tare_config).yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="kAutoStart" value="$(var auto_start)"/>
  </node>

  <!-- Terrain maps for far_planner only, from the scans without the tracked people (people_perception
       dynamic_points_filter; the same scans as /cloud_registered when people:=false). The terrain maps above keep the
       people, TARE and the goal bridge must not walk into them; in the graph FAR saves for the next missions a person
       walking by became a wall along the whole walk. Namespace far_static: the node names, which key
       terrain_airy.yaml, stay the same. -->
  <node if="$(var save_graph)" pkg="terrain_analysis" exec="terrainAnalysis" name="terrainAnalysis" namespace="far_static" output="screen">
    <param from="$(find-pkg-share legged_gazebo)/config/terrain_airy.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="carveDyObs" value="true"/>
    <remap from="/state_estimation" to="/Odometry"/>
    <remap from="/registered_scan" to="/registered_scan_static"/>
    <remap from="/terrain_map" to="/terrain_map_static"/>
  </node>
  <node if="$(var save_graph)" pkg="terrain_analysis_ext" exec="terrainAnalysisExt" name="terrainAnalysisExt" namespace="far_static" output="screen">
    <param from="$(find-pkg-share legged_gazebo)/config/terrain_airy.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="/state_estimation" to="/Odometry"/>
    <remap from="/registered_scan" to="/registered_scan_static"/>
    <remap from="/terrain_map" to="/terrain_map_static"/>
    <remap from="/terrain_map_ext" to="/terrain_map_ext_static"/>
  </node>

  <!-- far_planner only builds its graph here: its /way_point (also sent on a graph reset, with the robot position) is
       remapped away from the goal bridges, which take TARE's. name must stay far_planner: the yaml is keyed by node name -->
  <node if="$(var save_graph)" pkg="far_planner" exec="far_planner" name="far_planner" output="screen">
    <param from="$(find-pkg-share far_planner)/config/$(var far_config).yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="/odom_world" to="/Odometry"/>
    <remap from="/terrain_cloud" to="/terrain_map_ext_static"/>
    <remap from="/scan_cloud" to="/terrain_map_static"/>
    <remap from="/terrain_local_cloud" to="/registered_scan_static"/>
    <remap from="/way_point" to="/far_planner/way_point"/>
  </node>
  <node if="$(var save_graph)" pkg="graph_decoder" exec="graph_decoder" name="graph_decoder" output="screen">
    <param name="world_frame" value="map"/>
    <param name="visual_scale_ratio" value="0.5"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node unless="$(var waypoint)" pkg="tare_planner" exec="tare_path_to_opti_pessi_goal.py" name="tare_path_to_opti_pessi_goal" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
  <node if="$(var waypoint)" pkg="tare_planner" exec="way_point_to_opti_pessi_goal.py" name="way_point_to_opti_pessi_goal" output="screen"/>

  <!-- On /exploration_finish: with return_home, first waits until TARE has brought the robot back to where it stood
       when this launch started (within 0.5 m, or return_home_timeout). Then SIGINT to tare_planner_node and the
       goal bridges, a stop goal at the robot, then makeMergedMap.py (.venv-yolo python, no viewer) on alaserPGO's
       save_directory; log next to the map.
       With save_graph, the FAR graph is saved there too (/save_file_dir -> graph_decoder), then far_planner and
       graph_decoder are stopped. Wall-time node: flush_time waits for SC-PGO's 1 Hz pose file rewrite. -->
  <let name="finish_graph_name" value=""/>
  <let if="$(var save_graph)" name="finish_graph_name" value="$(var graph_name)"/>
  <node if="$(var merge_map)" pkg="tare_planner" exec="tare_finish_merge_map.py" name="tare_finish_merge_map" output="screen">
    <param name="map_name" value="$(var map_name)"/>
    <param name="graph_name" value="$(var finish_graph_name)"/>
    <param name="return_home" value="$(var return_home)"/>
    <param name="return_home_timeout" value="$(var return_home_timeout)"/>
  </node>

  <node if="$(var rviz)" pkg="rviz2" exec="rviz2" name="tare_nav_rviz"
    args="-d $(find-pkg-share tare_planner)/tare_planner_warehouse.rviz">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
